#/ 
  Standard module 'vectors.kvl' 
  - Useful for working with vectors
/#

module panics = "std/panics"


form[T] push(T@ vec, T val) pub do
  #/
    Pushes the value at the end of the vector
  /#
  int size = len: vec
  resize:(vec, size + 1)
  vec[size] = val
end

form[T] T popped(T@ vec) pub do
  #/
    Returns and removes the value from the end of the vector
  /#
  closure panics

  int size = len: vec
  if size == 0 do
    panic:(panics.outOfBounds, "vector out if bounds")
  end
  T result = vec[-1]
  resize:(vec, size - 1)
  return result
end

form[T] pop(T@ vec) pub do
  #/
    Removes the value from the end of the vector
  /#
  closure panics

  int size = len: vec
  if size == 0 do
    panic:(panics.outOfBounds, "vector out if bounds")
  end
  resize:(vec, size - 1)
end

form[T] clear(T@ vec) pub do
  #/
    Clears a vector by resetting all elements to their default values
  /#
  int len = len: vec
  if len == 0 do return end
  int i
  T def = default: T
  while i < len do
    vec[i] = def
    i = i + 1
  end
end

form[T] insert(T@ vec, int index, T val) pub do
  #/
    Inserts a value at the specified index, shifting elements to the right
    Negative index wraps around: -1 = last position
  /#
  closure panics

  int size = len: vec
  if index < 0 do
    index = size + index + 1
  end

  if index < 0 or index > size do
    panic:(panics.outOfBounds, "index out of bounds")
  end

  resize:(vec, size + 1)

  int i = size
  while i > index do
    vec[i] = vec[i - 1]
    i = i - 1
  end

  vec[index] = val
end

form[T] remove(T@ vec, int index) pub do
  #/
    Removes the element at the specified index, shifting elements to the left
  /#
  closure panics

  int size = len: vec
  if index < 0 do
    index = size + index
  end

  if index < 0 or index >= size do
    panic:(panics.outOfBounds, "index out of bounds")
  end

  int i = index
  while i < size - 1 do
    vec[i] = vec[i + 1]
    i = i + 1
  end

  resize:(vec, size - 1)
end

form[T] int find(T@ vec, T val) pub do
  #/
    Returns the index of the first occurrence of val in the vector
    Panics if the value is not found
  /#
  closure panics

  int size = len: vec
  int i = 0
  while i < size do
    if vec[i] == val do
      return i
    end
    i = i + 1
  end
  panic:(panics.valueError, "value not found in vector")
end

form[T] bool contains(T@ vec, T val) pub do
  #/
    Returns true if the vector contains the specified value
  /#
  int size = len: vec
  int i = 0
  while i < size do
    if vec[i] == val do
      return true
    end
    i = i + 1
  end
  return false
end

form[T] reverse(T@ vec) pub do
  #/
    Reverses the vector in-place
  /#
  int size = len: vec
  if size <= 1 do
    return
  end

  int left = 0
  int right = size - 1
  while left < right do
    T temp = vec[left]
    vec[left] = vec[right]
    vec[right] = temp
    left = left + 1
    right = right - 1
  end
end

form[T] T@ copy(T@ vec) pub do
  #/
    Returns a shallow copy of the vector
  /#
  int size = len: vec
  T@ result = vec:T[]
  resize:(result, size)
  
  int i = 0
  while i < size do
    result[i] = vec[i]
    i = i + 1
  end
  
  return result
end

form[T] T@ concat(T@ vec, T@ other) pub do
  #/
    Returns a new vector containing all elements of vec followed by all elements of other
  /#
  int size1 = len: vec
  int size2 = len: other
  int totalSize = size1 + size2
  
  T@ result = vec:T[]
  resize:(result, totalSize)
  
  int i = 0
  while i < size1 do
    result[i] = vec[i]
    i = i + 1
  end
  
  int j = 0
  while j < size2 do
    result[size1 + j] = other[j]
    j = j + 1
  end
  
  return result
end

form[T] trim(T@ vec) pub do
  #/
    Removes default values from the beginning and end of the vector
  /#
  int size = len: vec
  if size == 0 do
    return
  end

  T def = default: T
  
  int left = 0
  while left < size and vec[left] == def do
    left = left + 1
  end
  
  if left == size do
    resize:(vec, 0)
    return
  end
  
  int right = size - 1
  while right >= 0 and vec[right] == def do
    right = right - 1
  end
  
  int newSize = right - left + 1
  int i = 0
  while i < newSize do
    vec[i] = vec[left + i]
    i = i + 1
  end
  
  resize:(vec, newSize)
end

form[T] bool isEmpty(T@ vec) pub do
  #/
    Returns true if the vector contains only default values (T's zero value)
    An empty vector (len: vec == 0) is also considered empty
  /#
  int size = len: vec
  if size == 0 do
    return true
  end

  T def = default: T
  int i = 0
  while i < size do
    if vec[i] != def do
      return false
    end
    i = i + 1
  end
  return true
end

form[T] T@ filter(T@ vec, bool(T) cond) pub do
  #/
    Returns a new vector containing only elements that satisfy the predicate
  /#
  int size = len: vec
  T@ result = vec:T[]
  
  int count = 0
  int i = 0
  while i < size do
    if cond(vec[i]) do
      count = count + 1
    end
    i = i + 1
  end
  
  resize:(result, count)
  
  int pos = 0
  i = 0
  while i < size do
    if cond(vec[i]) do
      result[pos] = vec[i]
      pos = pos + 1
    end
    i = i + 1
  end
  
  return result
end

form[A, B] B@ map(A@ arr, B(A) mapper) pub do
  #/
    Applies a function to each element of the array, returning a new vector of the results
  /#
  int size = len: arr
  B@ result = vec:B[]
  resize:(result, size)
  
  int i = 0
  while i < size do
    result[i] = mapper(arr[i])
    i = i + 1
  end
  
  return result
end

form[A, B] B fold(A@ arr, B start, B(A, B) reducer) pub do
  #/
    Folds (reduces) the array using a binary function, starting with an initial value.
    The reducer receives the current element and the accumulated value.
    Returns the final accumulated value.
  /#
  int size = len: arr
  B acc = start
  
  int i = 0
  while i < size do
    acc = reducer(arr[i], acc)
    i = i + 1
  end
  
  return acc
end

form[A, B] B fold(A@ arr, B start, B(A, A, int) reducer) pub do
  #/
    Folds (reduces) the array using a binary function that also receives the current index.
    The reducer receives the current element, the accumulated value, and the index.
    Returns the final accumulated value.
  /#
  int size = len: arr
  B acc = start
  
  int i = 0
  while i < size do
    acc = reducer(arr[i], acc, i)
    i = i + 1
  end
  
  return acc
end

func testAll() do
  int@ v = vec:{10, 20, 30}

  assert:(len:(v) == 3, "push")
  assert:(v[0] == 10 and v[1] == 20 and v[2] == 30, "push values")

  int x = popped$[int](v)
  assert:(x == 30 and len:(v) == 2, "popped")
  assert:(v[0] == 10 and v[1] == 20, "popped values")

  pop$[int](v)
  assert:(len:(v) == 1 and v[0] == 10, "pop without return")

  # pop[int](v) 

  push$[int](v, 20)
  push$[int](v, 30)
  assert:(v[0] == 10 and v[1] == 20 and v[2] == 30, "before clear")
  clear$[int](v)
  assert:(len:(v) == 3 and v[0] == 0 and v[1] == 0 and v[2] == 0, "after clear")

  v = vec:{10, 20, 30}

  insert$[int](v, -1, 40)
  assert:(v[3] == 40 and len:(v) == 4, "insert negative -1")

  insert$[int](v, -2, 25)
  assert:(v[3] == 25 and len:(v) == 5, "insert negative -2")

  insert$[int](v, 0, 5)
  assert:(v[0] == 5 and len:(v) == 6, "insert at beginning")

  remove$[int](v, -1)
  assert:(len:(v) == 5 and v[4] == 25, "remove negative -1")

  remove$[int](v, -3)
  assert:(len:(v) == 4 and v[2] == 30, "remove negative -3")

  # insert[int](v, -10, 0)
  # insert[int](v, 10, 0)
  # remove[int](v, -10)
  # remove[int](v, 10)

  v = vec:{10, 20, 30}

  assert:(find$[int](v, 20) == 1, "find exists")
  assert:(find$[int](v, 10) == 0, "find first")
  assert:(find$[int](v, 30) == 2, "find last")

  # find$[int](v, 99)

  assert:(contains$[int](v, 20), "contains exists")
  assert:(contains$[int](v, 10), "contains first")
  assert:(contains$[int](v, 30), "contains last")
  assert:(!contains$[int](v, 99), "contains not found")
  assert:(!contains$[int](vec:int[], 10), "contains empty")

  reverse$[int](v)
  assert:(len:(v) == 3 and v[0] == 30 and v[1] == 20 and v[2] == 10, "reverse odd")

  push$[int](v, 40)
  reverse$[int](v)
  assert:(len:(v) == 4 and v[0] == 40 and v[1] == 10 and v[2] == 20 and v[3] == 30, "reverse even")

  int@ empty = vec:int[]
  reverse$[int](empty)
  assert:(len:(empty) == 0, "reverse empty")

  int@ single = vec:int[]
  push$[int](single, 42)
  reverse$[int](single)
  assert:(single[0] == 42 and len:(single) == 1, "reverse single")

  v = vec:{10, 20, 30}
  int@ copy = copy$[int](v)

  assert:(len:(copy) == 3, "copy length")
  assert:(copy[0] == 10 and copy[1] == 20 and copy[2] == 30, "copy values")

  copy[0] = 99
  assert:(v[0] == 10, "original unchanged")
  assert:(copy[0] == 99, "copy modified")

  v = vec:int[]
  int@ emptyCopy = copy$[int](v)
  assert:(len:(emptyCopy) == 0, "copy empty")

  v = vec:{10, 20, 30}
  int@ other = vec:{40, 50, 60}
  int@ concatted = concat$[int](v, other)

  assert:(len:(concatted) == 6, "concat length")
  assert:(concatted[0] == 10 and concatted[1] == 20 and concatted[2] == 30, "concat first part")
  assert:(concatted[3] == 40 and concatted[4] == 50 and concatted[5] == 60, "concat second part")

  # Проверка что оригиналы не изменились
  assert:(len:(v) == 3 and len:(other) == 3, "originals unchanged")

  # Пустые векторы
  v = vec:int[]
  other = vec:{1, 2, 3}
  concatted = concat$[int](v, other)
  assert:(len:(concatted) == 3 and concatted[0] == 1, "concat empty with non-empty")

  v = vec:{1, 2, 3}
  other = vec:int[]
  concatted = concat$[int](v, other)
  assert:(len:(concatted) == 3 and concatted[0] == 1, "concat non-empty with empty")

  v = vec:int[]
  other = vec:int[]
  concatted = concat$[int](v, other)
  assert:(len:(concatted) == 0, "concat both empty")

  v = vec:{0, 0, 10, 20, 30, 0, 0}
  trim$[int](v)
  assert:(len:(v) == 3 and v[0] == 10 and v[1] == 20 and v[2] == 30, "trim default values")

  v = vec:{0, 0, 0}
  trim$[int](v)
  assert:(len:(v) == 0, "trim all default")

  v = vec:{10, 20, 30}
  trim$[int](v)
  assert:(len:(v) == 3 and v[0] == 10 and v[2] == 30, "trim no default")

  v = vec:{0, 10, 20, 0}
  trim$[int](v)
  assert:(len:(v) == 2 and v[0] == 10 and v[1] == 20, "trim mixed")

  v = vec:int[]
  trim$[int](v)
  assert:(len:(v) == 0, "trim empty")

  v = vec:{0, 0, 0}
  assert:(isEmpty$[int](v), "isEmpty all default")

  v = vec:{0, 10, 0}
  assert:(!isEmpty$[int](v), "isEmpty not all default")

  v = vec:{10, 20, 30}
  assert:(!isEmpty$[int](v), "isEmpty none default")

  v = vec:int[]
  assert:(isEmpty$[int](v), "isEmpty empty")

  string@ sv = vec:string[]
  push$[string](sv, v"")
  push$[string](sv, v"")
  assert:(isEmpty$[string](sv), "isEmpty string all empty")

  push$[string](sv, v"hello")
  assert:(!isEmpty$[string](sv), "isEmpty string not empty")

  func bool isEven(int x) do
    return x % 2 == 0
  end

  func bool isPositive(int x) do
    return x > 0
  end

  v = vec:{-5, 10, -3, 20, 0, 30, -1}
  int@ evens = filter$[int](v, isEven)
  assert:(len:(evens) == 4 and evens[0] == 10 and evens[1] == 20 and evens[2] == 0 and evens[3] == 30, "filter even")

  int@ positives = filter$[int](v, isPositive)
  assert:(len:(positives) == 3 and positives[0] == 10 and positives[1] == 20 and positives[2] == 30, "filter positive")

  v = vec:int[]
  empty = filter$[int](v, isEven)
  assert:(len:(empty) == 0, "filter empty")

  func int double(int x) do
    return x * 2
  end

  func uint toUint(int x) do
    return x as uint
  end

  v = vec:{1, 2, 3, 4, 5}
  int@ doubled = map$[int, int](v, double)
  assert:(len:(doubled) == 5, "map length")
  assert:(doubled[0] == 2 and doubled[1] == 4 and doubled[2] == 6 and doubled[3] == 8 and doubled[4] == 10, "map double")

  uint@ uinted = map$[int, uint](v, toUint)
  assert:(len:(uinted) == 5, "map length 2")
  for i = uinted do
    assert:(i == i as uint, "map uint")
  end

  func int add(int a, int b) do
    return a + b
  end

  func int mul(int a, int b) do
    return a * b
  end

  func string concat(string a, string b) do
    return fmt:(a, b)
  end

  v = vec:{1, 2, 3, 4, 5}
  int sum = fold$[int, int](v, 0, add)
  assert:(sum == 15, "fold sum")

  int product = fold$[int, int](v, 1, mul)
  assert:(product == 120, "fold product")

  func int addWithIndex(int a, int b, int idx) do
    return a + b + idx
  end

  int sumWithIndex = fold$[int, int](v, 0, addWithIndex)
  # 0 + (1+0) + (2+1) + (3+2) + (4+3) + (5+4) = 25
  assert:(sumWithIndex == 25, "fold with index")

  sv = vec:string[]
  push$[string](sv, v"A")
  push$[string](sv, v"B")
  push$[string](sv, v"C")

  string concatenated = fold$[string, string](sv, v"", concat)
  assert:(concatenated == v"ABC", "fold string concat")

  # v = vec:int[]
  # reduce$[int](v, add)

  func string indexedConcat(string s, string acc, int idx) do
    return fmt:(acc, idx, ":", s, " ")
  end

  sv = vec:string[]
  push$[string](sv, v"A")
  push$[string](sv, v"B")
  push$[string](sv, v"C")

  string indexed = fold$[string, string](sv, v"", indexedConcat)
  assert:(indexed == v"0:A 1:B 2:C ", "fold string with index")

  print:v"All vectors tests passed!"
end

testAll()