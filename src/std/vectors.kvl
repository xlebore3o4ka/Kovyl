module panics = "std/panics"

form[T] push(T@ vec, T val) pub do
  int size = len: vec
  resize:(vec, size + 1)
  vec[size] = val
end

form[T] T pop(T@ vec) pub do
  closure panics

  int size = len: vec
  if size == 0 do
    panic:(panics.outOfBounds, "vector out if bounds")
  end
  T result = vec[size - 1]
  resize:(vec, size - 1)
  return result
end

form[T] pop(T@ vec) pub do
  closure panics

  int size = len: vec
  if size == 0 do
    panic:(panics.outOfBounds, "vector out if bounds")
  end
  resize:(vec, size - 1)
end